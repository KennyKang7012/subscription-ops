# 換行字元：入庫與 checkout 一律 LF，避免 Windows / macOS 之間產生整檔 diff
* text=auto eol=lf

# 二進位檔（不做換行轉換）
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary

# Windows 專用腳本保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 在 GitHub 上收合自動產生的檔案
package-lock.json linguist-generated
